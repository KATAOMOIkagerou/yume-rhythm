// 设置页的字体卡片：可搜索的中/英文字体分离选择、全局字号调节、导入字体与恢复默认。

import { Theme } from "theme.slint";
import { ButtonKind, Card, Notice, PillButton } from "widgets.slint";
import { RangeSlider } from "controls.slint";
import { SearchableFontPicker } from "font_picker.slint";
import { Store } from "store.slint";

export component FontCard inherits Card {
    title: "界面字体";
    hint: "支持关键词检索，中英字形隔离生效";

    VerticalLayout {
        spacing: 4px;
        Text {
            text: "中文字体";
            font-size: Theme.font-caption;
            color: Theme.text-secondary;
        }
        zh-picker := SearchableFontPicker {
            current-label: Store.settings.zh-font-label;
            options: Store.zh-fonts;
            open-changed(is-open) => {
                if (is-open) {
                    en-picker.close();
                }
            }
            query-changed(q) => { Store.filter-zh-fonts(q); }
            picked(idx) => { Store.select-zh-font(idx); }
        }
    }

    VerticalLayout {
        spacing: 4px;
        Text {
            text: "英文字体";
            font-size: Theme.font-caption;
            color: Theme.text-secondary;
        }
        en-picker := SearchableFontPicker {
            current-label: Store.settings.en-font-label;
            options: Store.en-fonts;
            open-changed(is-open) => {
                if (is-open) {
                    zh-picker.close();
                }
            }
            query-changed(q) => { Store.filter-en-fonts(q); }
            picked(idx) => { Store.select-en-font(idx); }
        }
    }

    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            Text {
                text: "字号大小";
                font-size: Theme.font-body;
                color: Theme.text;
                horizontal-stretch: 1;
            }
            Text {
                text: Store.settings.font-size-text;
                font-size: Theme.font-body;
                font-weight: 500;
                color: Theme.accent-strong-text;
            }
        }
        font-size-slider := RangeSlider {
            label: "字号大小";
            minimum: 11;
            maximum: 18;
            step: 1;
            value: Store.settings.font-size;
            changed(v) => { Store.set-font-size(round(v)); }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        PillButton {
            kind: ButtonKind.secondary;
            compact: true;
            text: "导入字体 (.ttf/.otf)";
            clicked => { Store.pick-custom-font(); }
        }
        PillButton {
            kind: ButtonKind.ghost;
            compact: true;
            text: "恢复默认";
            clicked => { Store.reset-font(); }
        }
    }
    if Store.settings.font-status != "": Notice {
        text: Store.settings.font-status;
        tone: Store.settings.font-failed ? Theme.red : Theme.text-secondary;
        tone-soft: Store.settings.font-failed ? Theme.red-soft : Theme.surface-alt;
    }

    property <int> model-font-size: Store.settings.font-size;
    changed model-font-size => {
        if (round(font-size-slider.value) != root.model-font-size) {
            font-size-slider.value = root.model-font-size;
        }
    }
}
