// 「设置」页：外观、透明度、字体、桌宠、角色、通用、快捷键、关于。

import { AboutSlint, ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ButtonKind, Card, Notice, PillButton, SettingRow } from "widgets.slint";
import { RangeSlider, Toggle } from "controls.slint";
import { Store } from "store.slint";
import { AccentCard, BackgroundCard } from "appearance.slint";
import { CornerCard, OpacityCard } from "window_style.slint";
import { FontCard } from "font_card.slint";
import { ShortcutsCard } from "shortcuts.slint";

component ScaleRow inherits VerticalLayout {
    spacing: 6px;
    HorizontalLayout {
        Text {
            text: "桌宠大小";
            font-size: Theme.font-body;
            color: Theme.text;
            horizontal-stretch: 1;
        }
        Text {
            text: Store.settings.pet-scale-text;
            font-size: Theme.font-body;
            font-weight: 500;
            color: Theme.accent-strong-text;
        }
    }
    scale := RangeSlider {
        label: "桌宠大小";
        minimum: 0.5;
        maximum: 2.0;
        step: 0.05;
        value: Store.settings.pet-scale;
        changed(v) => { Store.set-pet-scale(v); }
    }

    property <float> model-scale: Store.settings.pet-scale;
    changed model-scale => {
        if (abs(scale.value - root.model-scale) > 0.001) {
            scale.value = root.model-scale;
        }
    }
}

component CharacterCard inherits Card {
    title: "角色";

    HorizontalLayout {
        spacing: 8px;
        picker := ComboBox {
            horizontal-stretch: 1;
            model: Store.characters;
            current-index: Store.settings.character-index;
            selected => { Store.select-character(self.current-index); }
        }
        PillButton {
            text: "重新载入";
            clicked => { Store.reload-character(); }
        }
    }
    if Store.settings.character-status != "": Notice {
        text: Store.settings.character-status;
        tone: Store.settings.character-failed ? Theme.red : Theme.text-secondary;
        tone-soft: Store.settings.character-failed ? Theme.red-soft : Theme.surface-alt;
    }

    property <int> model-index: Store.settings.character-index;
    changed model-index => {
        if (picker.current-index != root.model-index) {
            picker.current-index = root.model-index;
        }
    }
}

export component SettingsPage inherits ScrollView {
    content-width: self.visible-width;
    VerticalLayout {
        padding: Theme.page-padding;
        spacing: Theme.gap;
        alignment: start;

        BackgroundCard { }
        AccentCard { }
        CornerCard { }
        OpacityCard { }
        FontCard { }

        Card {
            title: "桌宠";
            ScaleRow { }
            SettingRow {
                title: "锁定桌宠";
                description: "锁定后鼠标会穿过桌宠。可在托盘菜单或按全局锁定快捷键解除";
                Toggle {
                    label: "锁定桌宠";
                    checked: Store.settings.locked;
                    toggled(on) => { Store.set-locked(on); }
                }
            }
            SettingRow {
                title: "全屏时隐藏";
                description: "看视频、玩游戏时自动躲起来";
                Toggle {
                    label: "全屏时隐藏";
                    checked: Store.settings.hide-on-fullscreen;
                    toggled(on) => { Store.set-hide-on-fullscreen(on); }
                }
            }
        }

        CharacterCard { }

        Card {
            title: "通用";
            SettingRow {
                title: "倒计时结束提示音";
                Toggle {
                    label: "倒计时结束提示音";
                    checked: Store.settings.end-sound;
                    toggled(on) => { Store.set-end-sound(on); }
                }
            }
            SettingRow {
                title: "开机自动启动";
                Toggle {
                    label: "开机自动启动";
                    checked: Store.settings.autostart;
                    toggled(on) => { Store.set-autostart(on); }
                }
            }
        }

        ShortcutsCard { }

        Card {
            title: "关于";
            hint: Store.settings.version;
            Text {
                text: "韵梦桌伴 · MIT 许可";
                font-size: Theme.font-body;
                color: Theme.text-secondary;
            }
            HorizontalLayout {
                alignment: center;
                AboutSlint {
                    max-height: 120px;
                }
            }
        }

        HorizontalLayout {
            alignment: center;
            padding-bottom: 8px;
            PillButton {
                kind: ButtonKind.danger;
                text: "退出韵梦桌伴";
                clicked => { Store.quit(); }
            }
        }
    }
}
