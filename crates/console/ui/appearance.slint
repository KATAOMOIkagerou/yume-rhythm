// 设置页的外观模块：背景模式与透明度、背景图片、强调色（含第 6 项自定义折叠面板）。

import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ButtonKind, Card, Chip, Notice, PillButton } from "widgets.slint";
import { RangeSlider } from "controls.slint";
import { AccentOption, Store } from "store.slint";

component AccentSwatchChip inherits Rectangle {
    in property <AccentOption> option;
    callback clicked();

    height: 30px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-small;
    background: root.option.active ? Theme.accent-soft
        : ta.has-hover ? Theme.surface-hover : Theme.surface-alt;
    border-width: 1px;
    border-color: root.option.active ? Theme.accent : Theme.border;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.option.swatch;
                border-width: 1px;
                border-color: Theme.border;
            }
        }
        Text {
            text: root.option.name;
            font-size: Theme.font-caption;
            font-weight: root.option.active ? 600 : 400;
            color: root.option.active ? Theme.accent-strong-text : Theme.text;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component BackgroundCard inherits Card {
    title: "背景";

    HorizontalLayout {
        spacing: 6px;
        Chip {
            horizontal-stretch: 1;
            text: "浅色";
            selected: Store.settings.background-index == 0;
            clicked => { Store.set-background-mode("light"); }
        }
        Chip {
            horizontal-stretch: 1;
            text: "深色";
            selected: Store.settings.background-index == 1;
            clicked => { Store.set-background-mode("dark"); }
        }
        Chip {
            horizontal-stretch: 1;
            text: "自定义";
            selected: Store.settings.background-index == 2;
            clicked => { Store.set-background-mode("custom"); }
        }
    }

    if Store.settings.background-index == 2: HorizontalLayout {
        spacing: 6px;
        bg-input := LineEdit {
            horizontal-stretch: 1;
            text: Store.settings.custom-background;
            placeholder-text: "输入背景色，如 #1c1f2b";
            font-size: Theme.font-caption;
            accepted(t) => { Store.set-custom-background(t); }
        }
        PillButton {
            kind: ButtonKind.secondary;
            compact: true;
            text: "应用";
            clicked => { Store.set-custom-background(bg-input.text); }
        }

        property <string> model-bg: Store.settings.custom-background;
        changed model-bg => {
            if (bg-input.text != self.model-bg) {
                bg-input.text = self.model-bg;
            }
        }
    }

    if Store.settings.bg-error: Notice {
        text: "背景色格式不对，请输入 6 位十六进制色值（例如 #1c1f2b）";
        tone: Theme.red;
        tone-soft: Theme.red-soft;
    }

    Rectangle {
        height: 1px;
        background: Theme.divider;
    }

    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            Text {
                text: "背景透明度";
                font-size: Theme.font-body;
                color: Theme.text;
                horizontal-stretch: 1;
            }
            Text {
                text: Store.settings.bg-opacity-text;
                font-size: Theme.font-body;
                font-weight: 500;
                color: Theme.accent-strong-text;
            }
        }
        bg-alpha-slider := RangeSlider {
            label: "背景透明度";
            minimum: 0.0;
            maximum: 1.0;
            step: 0.05;
            value: Store.settings.bg-opacity;
            changed(v) => { Store.set-bg-opacity(v); }
        }

        property <float> model-bg-alpha: Store.settings.bg-opacity;
        changed model-bg-alpha => {
            if (abs(bg-alpha-slider.value - self.model-bg-alpha) > 0.001) {
                bg-alpha-slider.value = self.model-bg-alpha;
            }
        }
    }

    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            Text {
                text: "卡片透明度";
                font-size: Theme.font-body;
                color: Theme.text;
                horizontal-stretch: 1;
            }
            Text {
                text: Store.settings.card-opacity-text;
                font-size: Theme.font-body;
                font-weight: 500;
                color: Theme.accent-strong-text;
            }
        }
        card-alpha-slider := RangeSlider {
            label: "卡片透明度";
            minimum: 0.0;
            maximum: 1.0;
            step: 0.05;
            value: Store.settings.card-opacity;
            changed(v) => { Store.set-card-opacity(v); }
        }

        property <float> model-card-alpha: Store.settings.card-opacity;
        changed model-card-alpha => {
            if (abs(card-alpha-slider.value - self.model-card-alpha) > 0.001) {
                card-alpha-slider.value = self.model-card-alpha;
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.divider;
    }

    HorizontalLayout {
        spacing: 6px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: "背景图片";
                font-size: Theme.font-body;
                color: Theme.text;
            }
            Text {
                text: Store.settings.has-bg-image ? Store.settings.bg-image-name : "未设置（纯色背景）";
                font-size: Theme.font-caption;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 4px;
                PillButton {
                    kind: ButtonKind.secondary;
                    compact: true;
                    text: "导入图片";
                    clicked => { Store.pick-background-image(); }
                }
                if Store.settings.has-bg-image: PillButton {
                    kind: ButtonKind.ghost;
                    compact: true;
                    text: "清除";
                    clicked => { Store.clear-background-image(); }
                }
            }
        }
    }

    if Store.settings.has-bg-image: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            Text {
                text: "遮罩浓度";
                font-size: Theme.font-body;
                color: Theme.text;
                horizontal-stretch: 1;
            }
            Text {
                text: Store.settings.bg-dim-text;
                font-size: Theme.font-body;
                font-weight: 500;
                color: Theme.accent-strong-text;
            }
        }
        dim-slider := RangeSlider {
            label: "背景遮罩浓度";
            minimum: 0.2;
            maximum: 0.95;
            step: 0.05;
            value: Store.settings.bg-dim;
            changed(v) => { Store.set-background-dim(v); }
        }

        property <float> model-dim: Store.settings.bg-dim;
        changed model-dim => {
            if (abs(dim-slider.value - self.model-dim) > 0.001) {
                dim-slider.value = self.model-dim;
            }
        }
    }

    if Store.settings.bg-image-error != "": Notice {
        text: Store.settings.bg-image-error;
        tone: Theme.red;
        tone-soft: Theme.red-soft;
    }
}

export component AccentCard inherits Card {
    title: "强调色";

    if Store.accent-presets.length >= 6: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            for idx in [0, 1, 2]: AccentSwatchChip {
                option: Store.accent-presets[idx];
                clicked => { Store.set-accent(Store.accent-presets[idx].key); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            for idx in [3, 4, 5]: AccentSwatchChip {
                option: Store.accent-presets[idx];
                clicked => { Store.set-accent(Store.accent-presets[idx].key); }
            }
        }
    }

    if Store.settings.accent-custom-open: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            accent-input := LineEdit {
                horizontal-stretch: 1;
                text: Store.settings.custom-accent;
                placeholder-text: "自定义强调色，如 #ff6699";
                font-size: Theme.font-caption;
                accepted(t) => { Store.set-custom-accent(t); }
            }
            PillButton {
                kind: ButtonKind.secondary;
                compact: true;
                text: "应用";
                clicked => { Store.set-custom-accent(accent-input.text); }
            }
            PillButton {
                kind: ButtonKind.ghost;
                compact: true;
                text: "清除";
                clicked => {
                    accent-input.text = "";
                    Store.clear-custom-accent();
                }
            }
        }

        if Store.settings.accent-error: Notice {
            text: "颜色格式不对，请输入 6 位十六进制色值（例如 #ff6699）";
            tone: Theme.red;
            tone-soft: Theme.red-soft;
        }

        property <string> model-accent: Store.settings.custom-accent;
        changed model-accent => {
            if (accent-input.text != self.model-accent) {
                accent-input.text = self.model-accent;
            }
        }
    }
}
