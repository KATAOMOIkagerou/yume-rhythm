// 表单控件：开关、复选框、滑块。外观统一用主题色，不跟随系统强调色。

import { Theme } from "theme.slint";

/// 开关。
export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);

    accessible-role: switch;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(!root.checked); }

    width: 38px;
    height: 22px;
    border-radius: min(self.height / 2, Theme.radius-pill);
    opacity: root.enabled ? 1 : 0.45;
    background: root.checked ? Theme.accent : Theme.border;
    animate background { duration: 140ms; }

    knob := Rectangle {
        width: 16px;
        height: 16px;
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        border-radius: min(8px, Theme.radius-pill);
        background: Theme.surface-solid;
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000030;
        animate x { duration: 140ms; easing: ease-out; }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.toggled(!root.checked); }
    }
}

/// 方形复选框。
export component Check inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <color> tone: Theme.accent;
    in property <string> label;
    callback toggled(bool);

    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(!root.checked); }

    width: 20px;
    height: 20px;
    border-radius: min(6px, Theme.radius-small);
    opacity: root.enabled ? 1 : 0.35;
    background: root.checked ? root.tone : Theme.surface-solid;
    border-width: root.checked ? 0px : 1.5px;
    border-color: ta.has-hover && root.enabled ? root.tone : Theme.text-muted;
    animate background { duration: 120ms; }

    // 用矢量画勾，不依赖字体里有没有"✓"（微软雅黑没有）。
    if root.checked: Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 2.2 6.4 L 4.9 9.1 L 9.9 3.2";
        stroke: Theme.text-on-accent;
        stroke-width: 2px;
        fill: transparent;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.toggled(!root.checked); }
    }
}

/// 滑块。拖动或点击轨道改变数值，`changed` 只在用户操作时触发。
export component RangeSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0;
    in-out property <float> value;
    in property <string> label;
    callback changed(float);

    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => { root.set-value(root.value + max(root.step, (root.maximum - root.minimum) / 20)); }
    accessible-action-decrement => { root.set-value(root.value - max(root.step, (root.maximum - root.minimum) / 20)); }

    height: 24px;
    property <float> ratio: clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1);
    property <length> knob-size: 16px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.border;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        height: 4px;
        width: (root.width - root.knob-size) * root.ratio + root.knob-size / 2;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        width: root.knob-size;
        height: root.knob-size;
        x: (root.width - root.knob-size) * root.ratio;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.surface-solid;
        border-width: 2px;
        border-color: Theme.accent;
        drop-shadow-blur: ta.pressed ? 6px : 2px;
        drop-shadow-color: #d6558c55;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }

    function set-from(x: length) {
        let r = clamp((x - root.knob-size / 2) / (root.width - root.knob-size), 0, 1);
        root.set-value(root.minimum + r * (root.maximum - root.minimum));
    }

    function set-value(raw: float) {
        let snapped = root.step > 0 ? round(raw / root.step) * root.step : raw;
        let v = clamp(snapped, root.minimum, root.maximum);
        if (abs(v - root.value) > 0.0001) {
            root.value = v;
            root.changed(v);
        }
    }
}
