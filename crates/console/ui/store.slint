// 界面数据与操作。Rust 侧（src/bind/）写入数据、接收回调；页面只读数据、只调回调。
// 页面里不做业务判断：是否可用、是否显示、文案都由 Rust 侧算好。

export struct HeaderView {
    character: string,
    audio-text: string,
    audio-active: bool,
    locked: bool,
}

export struct FocusView {
    study: bool,
    countdown: bool,
    mode-locked: bool,
    minutes: int,
    minutes-editable: bool,
    time-text: string,
    status-text: string,
    // 0 未开始，1 计时中，2 已暂停，3 已结束
    phase: int,
    progress: float,
    show-progress: bool,
    can-reset: bool,
}

export struct TodoRow {
    id: int,
    text: string,
    done: bool,
}

export struct TodoView {
    name: string,
    can-remove: bool,
    done-count: int,
    total: int,
    md-bound: bool,
    md-label: string,
    md-error: string,
}

export struct ExpressionChip {
    id: string,
    name: string,
    active: bool,
    enabled: bool,
}

export struct EmotionView {
    current-name: string,
    current-random: bool,
    random-enabled: bool,
    random-interval: int,
    doze-note: bool,
}

export struct EditorView {
    open: bool,
    warning: string,
    canvas-hint: string,
}

export struct EditorRow {
    id: string,
    name: string,
    builtin: bool,
    primary: bool,
    summary: string,
}

export struct EditorDraftView {
    active: bool,
    is-new: bool,
    builtin: bool,
    primary: bool,
    name: string,
    eyes-text: string,
    mouth-text: string,
    overlay-text: string,
    has-eyes: bool,
    has-mouth: bool,
    has-overlay: bool,
    chill: bool,
    study: bool,
    music: bool,
    music-locked: bool,
    random: bool,
    duration-s: int,
    error: string,
    saving: bool,
    title: string,
}

export struct MusicView {
    // 0 未开始，1 连接中，2 同步中
    phase: int,
    status-text: string,
    source-text: string,
    button-text: string,
    show-bpm: bool,
    bpm-text: string,
    beat-locked: bool,
    beat-text: string,
    level: float,
    bass: float,
    can-shift: bool,
    silence-hint: bool,
    error-text: string,
    device-index: int,
    auto-follow: bool,
}

export struct AccentOption {
    key: string,
    name: string,
    swatch: color,
    active: bool,
}

export struct ShortcutItem {
    id: string,
    name: string,
    key-text: string,
    is-global: bool,
    can-clear: bool,
    failed: bool,
}

export struct FontOption {
    index: int,
    label: string,
    selected: bool,
}

export struct SettingsView {
    end-sound: bool,
    pet-scale: float,
    pet-scale-text: string,
    pet-opacity: float,
    pet-opacity-text: string,
    console-opacity: float,
    console-opacity-text: string,
    bg-opacity: float,
    bg-opacity-text: string,
    card-opacity: float,
    card-opacity-text: string,
    background-index: int,
    custom-background: string,
    bg-error: bool,
    accent-custom-open: bool,
    custom-accent: string,
    accent-error: bool,
    corner-index: int,
    corner-radius: int,
    corner-radius-text: string,
    has-bg-image: bool,
    bg-image-name: string,
    bg-dim: float,
    bg-dim-text: string,
    bg-image-error: string,
    shortcut-error: string,
    zh-font-index: int,
    en-font-index: int,
    zh-font-label: string,
    en-font-label: string,
    font-size: int,
    font-size-text: string,
    font-status: string,
    font-failed: bool,
    locked: bool,
    hide-on-fullscreen: bool,
    autostart: bool,
    character-index: int,
    character-status: string,
    character-failed: bool,
    version: string,
}

export global Store {
    in property <HeaderView> header;
    in property <FocusView> focus;
    in property <TodoView> todo;
    in property <[TodoRow]> todo-items;
    in property <EmotionView> emotion;
    in property <[ExpressionChip]> base-expressions;
    in property <[ExpressionChip]> accessory-expressions;
    in property <EditorView> editor;
    in property <[EditorRow]> editor-rows;
    in property <EditorDraftView> editor-draft;
    in property <MusicView> music;
    in property <[string]> devices;
    in property <SettingsView> settings;
    in property <[string]> characters;
    in property <[AccentOption]> accent-presets;
    in property <[ShortcutItem]> shortcuts;
    in property <[FontOption]> zh-fonts;
    in property <[FontOption]> en-fonts;
    // 当前正在录制快捷键时置为 true，避免顶层窗口快捷键误触发。
    in-out property <bool> recording-shortcut: false;
    // 0 无，1 确认暂停，2 确认离开自习，3 鼓励
    in property <int> dialog;

    // 专注
    callback select-activity(bool /* study */);
    callback set-countdown(bool);
    callback set-minutes(int);
    callback timer-primary();
    callback timer-reset();
    callback dialog-confirm();
    callback dialog-cancel();

    // 待办 & 外接 Markdown
    callback todo-rename(string);
    callback todo-add();
    callback todo-remove(int);
    callback todo-set-text(int, string);
    callback todo-set-done(int, bool);
    callback todo-pick-import-md();
    callback todo-pick-export-md();
    callback todo-reload-md();
    callback todo-unbind-md();

    // 表情 & 编辑器
    callback select-expression(string);
    callback set-random-enabled(bool);
    callback set-random-interval(int);
    callback editor-open();
    callback editor-close();
    callback editor-new();
    callback editor-edit(string);
    callback editor-cancel();
    callback editor-set-kind(bool /* primary */);
    callback editor-set-name(string);
    callback editor-pick-asset(int /* slot: 0=eyes, 1=mouth, 2=overlay */);
    callback editor-clear-asset(int /* slot */);
    callback editor-set-condition(int /* ctx: 0=chill, 1=study, 2=music */, bool);
    callback editor-set-random(bool);
    callback editor-set-duration-s(int);
    callback editor-reset-rule();
    callback editor-save();
    callback editor-delete(string);

    // 音乐
    callback audio-primary();
    callback audio-toggle();
    callback audio-stop();
    callback select-device(int);
    callback refresh-devices();
    callback shift-tempo(bool /* double */);
    callback open-sound-settings();
    callback set-show-bpm(bool);
    callback set-auto-follow(bool);

    // 设置：背景/透明度/强调色/圆角、字体/字号、快捷键、通用
    callback set-end-sound(bool);
    callback set-pet-scale(float);
    callback set-pet-opacity(float);
    callback set-console-opacity(float);
    callback set-bg-opacity(float);
    callback set-card-opacity(float);
    callback set-background-mode(string);
    callback set-custom-background(string);
    callback set-accent(string);
    callback set-custom-accent(string);
    callback clear-custom-accent();
    callback set-corner-mode(string);
    callback set-corner-radius(int);
    callback pick-background-image();
    callback clear-background-image();
    callback set-background-dim(float);
    callback record-shortcut(string /* action id */, bool /* ctrl */, bool /* alt */, bool /* shift */, string /* text */);
    callback clear-shortcut(string /* action id */);
    callback reset-shortcuts();
    callback console-key-pressed(bool /* ctrl */, bool /* alt */, bool /* shift */, string /* text */) -> bool;
    callback select-zh-font(int);
    callback select-en-font(int);
    callback filter-zh-fonts(string);
    callback filter-en-fonts(string);
    callback set-font-size(int);
    callback pick-custom-font();
    callback reset-font();
    callback set-locked(bool);
    callback set-hide-on-fullscreen(bool);
    callback set-autostart(bool);
    callback select-character(int);
    callback reload-character();
    callback hide-console();
    callback quit();
}
